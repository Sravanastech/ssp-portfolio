{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sravanasparimi.com/content-schema/work_project",
  "title": "Work project",
  "x-studio": {
    "type": "work_project",
    "shape": "item",
    "target": "workProjects",
    "collection": "workProjects",
    "page": "Work",
    "section": "Projects",
    "label": "Projects",
    "order": 20,
    "slugFrom": "id",
    "itemTitle": "{{domain}} · {{id}}"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "technologies",
    "description",
    "outcomes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "x-ui": {
        "label": "Identifier",
        "widget": "hidden",
        "help": "Generated automatically."
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "x-ui": {
        "label": "Domain",
        "widget": "text",
        "placeholder": "Full stack"
      }
    },
    "technologies": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "x-ui": {
        "label": "Technologies",
        "widget": "tags",
        "itemLabel": "Technology"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "x-ui": {
        "label": "Description",
        "widget": "textarea"
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-ui": {
              "label": "Outcome",
              "widget": "text"
            }
          }
        }
      },
      "x-ui": {
        "label": "Outcomes",
        "widget": "objectList",
        "itemTitle": "{{label}}"
      }
    }
  }
}
