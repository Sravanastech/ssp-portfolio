# ==============================================================================
# Monorepo Root .gitignore
# ==============================================================================

# OS files
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*-firebase-adminsdk-*.json

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs & Targets
dist/
dist-ssr/
target/
build/
.local/

# Test & Debug
test-results/
playwright-report/
firebase-debug.log
*.log

# Private Assets & Documents
private/
**/private/

# AI Tooling & Analyzer Caches
.claude/settings.local.json
.superpowers/
.ua/
.understand-anything/
docs/superpowers/


# Legacy repo backup and local tool artifacts
.git.bak/
.firebase/
profile-ui/artifacts/
profile-ui/premium-audit.json
**/.impeccable/hook.cache.json
