# ==============================================================================
# Monorepo root .gitignore (shared rules; sub-.gitignore files add project-only rules)
# ==============================================================================

# OS files
.DS_Store
Thumbs.db

# IDE & editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*-firebase-adminsdk-*.json

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs & targets
dist/
dist-ssr/
target/
build/
.local/

# Test & debug
test-results/
playwright-report/
firebase-debug.log
logs/
*.log

# Private assets, personal documents & generated reports (never track)
private/
**/private/
*.pdf
*.docx
**/perf-report*

# AI tooling & analyzer caches (local only)
.claude/
.impeccable/
.superpowers/
.ua/
.understand-anything/
**/docs/superpowers/
**/AI_MEMORY.md
profile-ui/DESIGN.md
profile-ui/PRODUCT.md

# Personal planning / learning notes (local only)
profile-ui/docs/README.md
profile-ui/docs/full-stack-learning-guide.*
profile-ui/docs/portfolio-leadership-review.md
profile-ui/docs/portfolio-v2-enhancements.md
profile-ui/docs/solutions-architecture-plan.md
profile-ui/docs/tools/
profile-backend/docs/learning-path.md

# Legacy backup & local tool artifacts
.git.bak/
.firebase/
profile-ui/artifacts/
profile-ui/premium-audit.json
