{
  "name": "profile-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "VITE_CONTENT_MODE=api vite",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=2",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx}'",
    "verify": "npm run format:check && npm run lint && npm run test:run && npm run build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/sitemap.mjs && node scripts/indexnow.mjs --write-key",
    "indexnow": "node scripts/indexnow.mjs --submit",
    "build:release": "node scripts/prepare-release.mjs && npm run build",
    "build:content-renderer": "node scripts/build-content-renderer.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "fix": "npm run format && npm run lint:fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "fix:prettier": "prettier --write .",
    "resume:pdf": "node scripts/build-resume.mjs",
    "test:coverage": "vitest run --coverage",
    "test:api": "playwright test --grep @api",
    "test:add-first-tests": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.29.0",
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.9"
    },
    "workbox-build": {
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
