# Public (browser-exposed) build configuration. Never put secrets here.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Production must be https://sravanasparimi.com (no localhost); see scripts/release-config.mjs
VITE_AUTH0_CALLBACK_URL=http://localhost:5173
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_WEB3FORMS_ACCESS_KEY=

# Local dev only: Java backend (profile-backend) target for the Vite /api proxy.
# Default is http://127.0.0.1:8080 (profile-backend/scripts/dev.sh).
VITE_API_URL=http://127.0.0.1:8080

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics
# and the consent banner entirely (dev, tests, prerender). Public value, not a secret.
VITE_GA_MEASUREMENT_ID=

# Cloudflare Turnstile site key (public). This is the always-pass dummy key for dev/test.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
