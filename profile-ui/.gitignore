# profile-ui project-specific rules.
# Shared rules (node_modules, dist, .env*, IDE, OS, AI tooling, private/) live in the root .gitignore.

# Lockfile: npm is the package manager (package-lock.json is the source of truth)
yarn.lock

# Vite / Playwright local overrides
*.local

# The only PDF allowed in git: a synthetic one-page e2e fixture (never the real resume)
!e2e/fixtures/sample-resume.pdf

# Added by QAForge setup
.qaforge/*
!.qaforge/setup.lock.json
coverage/
test-results/
playwright-report/
reports/mutation/
.stryker-tmp/

# Site Studio release snapshot, fetched by the deploy workflow for a release build
src/data/release.json
