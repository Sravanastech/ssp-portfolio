[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/DevSravana/ssp_profile_ui.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[http]
	postBuffer = 524288000
[pull]
	rebase = false
[branch "develop"]
	remote = origin
	merge = refs/heads/develop
	vscode-merge-base = origin/develop
[branch "main"]
	vscode-merge-base = origin/main
[branch "Fix-ts-config-typescript-7.0"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Fix-ts-config-typescript-7.0
[branch "Fix-deploy-and-firebase-json"]
	vscode-merge-base = origin/develop
	remote = origin
	merge = refs/heads/Fix-deploy-and-firebase-json
[branch "Upgrade-about-page"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Upgrade-about-page
[branch "feature/ssp2.0-redesign"]
	vscode-merge-base = origin/develop
	remote = origin
	merge = refs/heads/feature/ssp2.0-redesign
[branch "feature/ssp3.0-redesign"]
	vscode-merge-base = origin/develop
	remote = origin
	merge = refs/heads/feature/ssp3.0-redesign
[branch "feature/codex-astra-enhancements"]
	vscode-merge-base = origin/develop
	remote = origin
	merge = refs/heads/feature/codex-astra-enhancements
